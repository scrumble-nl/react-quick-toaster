{
  "compilerOptions": {
    "target": "es6",
    "module": "esnext",
    "declaration": true,
    "strict": true,
    "outDir": "./lib",
    "noImplicitAny": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "strictNullChecks": true,
    "lib": ["es5", "es2015", "es2016", "dom", "es2020"],
    "moduleResolution": "node"
  },
  "include": ["src"],
  "exclude": ["node_modules", "**/__tests__/*"]
}